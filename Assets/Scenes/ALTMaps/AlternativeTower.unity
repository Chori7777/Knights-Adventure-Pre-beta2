      objectReference: {fileID: 0}
    - target: {fileID: 1929520470402626097, guid: 429d871bc4a750740bae488722ec2054, type: 3}
      propertyPath: interactionDistance
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1929520470402626097, guid: 429d871bc4a750740bae488722ec2054, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 1929520470402626097, guid: 429d871bc4a750740bae488722ec2054, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: 'An inscription carved on this tombstone: '
      objectReference: {fileID: 0}
    - target: {fileID: 1929520470402626097, guid: 429d871bc4a750740bae488722ec2054, type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: '"It is with great sadness that I inform you that my headphones have
        finally died."'
      objectReference: {fileID: 0}
    - target: {fileID: 1929520470402626097, guid: 429d871bc4a750740bae488722ec2054, type: 3}
      propertyPath: 'dialogueLines.Array.data[3]'
      value: '"This morning they fell from a great height"'
      objectReference: {fileID: 0}
    - target: {fileID: 1929520470402626097, guid: 429d871bc4a750740bae488722ec2054, type: 3}
      propertyPath: 'dialogueLines.Array.data[4]'
      value: '"severing the few remaining wires that connected the microphone to
        the device."'
      objectReference: {fileID: 0}
    - target: {fileID: 1929520470402626097, guid: 429d871bc4a750740bae488722ec2054, type: 3}
      propertyPath: 'dialogueLines.Array.data[5]'
      value: '"I thought they would last until Christmas"'
      objectReference: {fileID: 0}
    - target: {fileID: 1929520470402626097, guid: 429d871bc4a750740bae488722ec2054, type: 3}
      propertyPath: 'dialogueLines.Array.data[6]'
      value: '" but unfortunately, that wasn''t the case..."'
      objectReference: {fileID: 0}
    - target: {fileID: 1929520470402626097, guid: 429d871bc4a750740bae488722ec2054, type: 3}
      propertyPath: 'dialogueLines.Array.data[7]'
      value: '" RIP Auris 2021-2025"'
      objectReference: {fileID: 0}
    - target: {fileID: 4398099848150233869, guid: 429d871bc4a750740bae488722ec2054, type: 3}
      propertyPath: m_Name
      value: Tomb (5)
      objectReference: {fileID: 0}
